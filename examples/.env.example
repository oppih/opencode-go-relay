# Copy to /etc/opencode-go-relay.env and chmod 600. Keys stay on the server.

# Required — your OpenCode Go subscription key
OPENCODE_GO_API_KEY=replace-with-your-go-key

# Required — client auth token (choose a long random string)
RELAY_TOKEN=replace-with-a-long-random-token

# Optional
# DEFAULT_MODEL=deepseek-v4-flash
# UPSTREAM_BASE=https://opencode.ai/zen/go/v1
# HOST=0.0.0.0
# PORT=8787
# STREAM_OPTIONS=1
# REQUEST_TIMEOUT=600

# Forward /v1/messages to the upstream Anthropic-native endpoint instead of translating it.
# Set to 1 only if your models speak the Anthropic protocol (others answer 400 ModelProtocolUnsupported).
# ANTHROPIC_PASSTHROUGH=0
# Stable fallback session id sent upstream when the client sends none (prompt-cache affinity).
# RELAY_SESSION_ID=
# UPSTREAM_ERROR_BODY_LIMIT=1048576
